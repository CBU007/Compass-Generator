# ====== Environment Variables ======
# Untuk Vercel: set nilai-nilai ini di dashboard (Settings > Environment Variables),
# BUKAN dengan meng-upload file ini. File .env hanya dipakai untuk testing lokal (vercel dev).

# WAJIB — API key Gemini dari Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIza_isi_key_anda_di_sini

# DISARANKAN — password yang dibagikan ke member.
# Kosongkan / hapus baris ini kalau ingin aplikasi bisa diakses tanpa password.
APP_PASSWORD=rahasia-tim-2026

# OPSIONAL — ganti model Gemini. Default: gemini-2.5-flash
# Pilihan lain mis.: gemini-2.5-flash-lite (lebih hemat) atau model terbaru lainnya.
GEMINI_MODEL=gemini-2.5-flash
